# Firebase — the club's project. Copy to `.env.local` for development, and set
# the same four in Vercel → Settings → Environment Variables for the live site.
#
# These are NOT secrets. A Firebase web API key identifies a project; it
# authorises nothing. What stops a stranger writing is `firestore.rules`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The one account allowed to edit. Must match the address in firestore.rules —
# this copy only decides what the page says when somebody else signs in.
VITE_ADMIN_EMAIL=forese@svce.ac.in

# Cloudinary — where gallery photographs are uploaded from the admin page.
# The preset is an unsigned one, restricted to the `forese/` folder.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_PRESET=
